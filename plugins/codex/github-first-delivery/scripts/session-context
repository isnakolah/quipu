#!/bin/sh
# Session start: give this agent session its own identity and show the board.
# Stop: remind the agent of work it still holds.
set -eu
input=""
[ -t 0 ] || input=$(cat)
if ! command -v gfd >/dev/null 2>&1; then
  printf '%s\n' 'gfd missing: source install required'
  exit 0
fi
git_dir=$(git rev-parse --git-dir 2>/dev/null || true)
lease=""
if [ -n "$git_dir" ] && [ -f "$git_dir/gfd-lease" ]; then
  lease=$(cat "$git_dir/gfd-lease")
fi
if [ "${1:-}" = "--stop" ]; then
  if [ -n "$lease" ]; then
    printf '%s\n' "gfd lease still held: $lease. Finish with 'gfd done N', or rerun 'gfd start N' to renew."
  fi
  exit 0
fi
session=$(printf '%s' "$input" | sed -n 's/.*"session_id"[[:space:]]*:[[:space:]]*"\([A-Za-z0-9-]*\)".*/\1/p' | cut -c1-8)
if [ -z "${GFD_AGENT:-}" ] && [ -n "$session" ]; then
  GFD_AGENT="codex/$session"
  export GFD_AGENT
  # Claude Code persists variables written here for later Bash commands.
  if [ -n "${CLAUDE_ENV_FILE:-}" ]; then
    printf 'export GFD_AGENT=%s\n' "$GFD_AGENT" >> "$CLAUDE_ENV_FILE"
  fi
fi
gfd status 2>/dev/null || true
if [ -n "$lease" ]; then
  printf '%s\n' "Resuming lease: $lease"
elif [ -z "${GFD_LEASE_ISSUE:-}" ]; then
  printf '%s\n' "No active lease: run 'gfd start --next' (or 'gfd start N') before editing."
fi
