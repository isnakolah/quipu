#!/bin/sh
# Session start: name the agent provider and show the board and this worktree's lease.
# Stop: remind the agent of work it still holds.
set -eu
[ -t 0 ] || cat >/dev/null
if ! command -v quipu >/dev/null 2>&1; then
  printf '%s\n' 'quipu missing: source install required'
  exit 0
fi
git_dir=$(git rev-parse --git-dir 2>/dev/null || true)
lease=""
if [ -n "$git_dir" ] && [ -f "$git_dir/quipu-lease" ]; then
  lease=$(cat "$git_dir/quipu-lease")
fi
if [ "${1:-}" = "--stop" ]; then
  if [ -n "$lease" ]; then
    printf '%s\n' "quipu lease still held: $lease. Finish with 'quipu done N', or rerun 'quipu start N' to renew."
  fi
  exit 0
fi
# Quipu names the lease holder claude/<login>/<worktree-id>: the identity
# belongs to the worktree, so parallel agents in separate worktrees never
# collide and a new session in the same worktree resumes its work.
if [ -z "${QUIPU_AGENT:-}" ]; then
  QUIPU_AGENT=claude
  export QUIPU_AGENT
  # Claude Code persists variables written here for later Bash commands.
  if [ -n "${CLAUDE_ENV_FILE:-}" ]; then
    printf 'export QUIPU_AGENT=%s\n' "$QUIPU_AGENT" >> "$CLAUDE_ENV_FILE"
  fi
fi
quipu status 2>/dev/null || true
if [ -n "$lease" ]; then
  printf '%s\n' "Resuming lease: $lease"
elif [ -z "${QUIPU_LEASE_ISSUE:-}" ]; then
  printf '%s\n' "No active lease in this worktree: run 'quipu start --next' (or 'quipu start N') before editing, or 'quipu start --next --worktree' to dispatch work into a new worktree."
fi
