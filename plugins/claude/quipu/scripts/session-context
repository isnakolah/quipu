#!/bin/sh
# SessionStart: name this agent, show the board, and give the one next
# command for this worktree. Stop: remind the agent of work it still holds.
set -eu
[ -t 0 ] || cat >/dev/null
if ! command -v quipu >/dev/null 2>&1; then
  printf '%s\n' 'quipu is not installed, so the guard denies every change in Quipu repositories. Ask the owner to install it (docs/source-install.md).'
  exit 0
fi
git_dir=$(git rev-parse --git-dir 2>/dev/null || true)
issue="" branch=""
if [ -n "$git_dir" ] && [ -f "$git_dir/quipu-lease" ]; then
  lease=$(cat "$git_dir/quipu-lease")
  issue=$(printf '%s' "$lease" | sed -n 's/.*"issue":\([0-9][0-9]*\).*/\1/p')
  branch=$(printf '%s' "$lease" | sed -n 's/.*"branch":"\([^"]*\)".*/\1/p')
fi
if [ "${1:-}" = "--stop" ]; then
  if [ -n "$issue" ]; then
    printf '%s\n' "This worktree still holds #$issue on $branch. If the work is unfinished, keep going; when the PR is ready, run: quipu done $issue --json"
  fi
  exit 0
fi
# Quipu names the lease holder claude/<login>/<worktree-id>: the identity
# belongs to the worktree, so parallel agents in separate worktrees never
# collide and a new session in the same worktree resumes its work.
if [ -z "${QUIPU_AGENT:-}" ]; then
  QUIPU_AGENT=claude
  export QUIPU_AGENT
  # Claude Code persists variables written here for later Bash commands.
  if [ -n "${CLAUDE_ENV_FILE:-}" ]; then
    printf 'export QUIPU_AGENT=%s\n' "$QUIPU_AGENT" >> "$CLAUDE_ENV_FILE"
  fi
fi
quipu status 2>/dev/null || true
if [ -n "$issue" ]; then
  printf '%s\n' "This worktree holds #$issue on $branch. Resume it: quipu start $issue --json"
else
  printf '%s\n' "This worktree holds no work, so edits are denied. Take work: quipu start --next --json. Rules: quipu guide"
fi
