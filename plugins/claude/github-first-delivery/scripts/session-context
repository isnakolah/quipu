#!/bin/sh
set -eu
if command -v gfd >/dev/null 2>&1; then
  gfd context --json 2>/dev/null || true
  git_dir=$(git rev-parse --git-dir 2>/dev/null || true)
  if [ -z "${GFD_LEASE_ISSUE:-}" ] && { [ -z "$git_dir" ] || [ ! -f "$git_dir/gfd-lease" ]; }; then
    printf '%s\n' 'gfd no active lease: run `gfd status`, then `gfd start N` before editing'
  fi
else
  printf '%s\n' 'gfd missing: source install required'
fi
